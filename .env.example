NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cerohambre

# Genera dos secretos diferentes de al menos 32 caracteres para tu entorno local.
JWT_SECRET=replace_with_at_least_32_random_characters
QR_SECRET=replace_with_a_different_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h

QR_TOKEN_TTL_SECONDS=90
QR_RENEW_SECONDS=60
MAX_PHOTO_SIZE_MB=5

# PayU Latam Sandbox: credenciales públicas compartidas para pruebas.
